  'mechanical-maintainer-levels': '/images/facility-drafts/11/01-maintainer-grades-hero.webp',
  'mechanical-career-records': '/images/facility-drafts/12/01-career-reporting-hero.webp',
  'boiler-inspection-manager': '/images/facility-drafts/13/01-boiler-manager-hero-v2.webp',
  'electric-unlimited': '/images/facility-electric/electric-unlimited.webp',
  'electric-license-appointment-comparison': '/images/facility-electric/electric-license-appointment-comparison.webp',
};
type Thumbnail = readonly [src: string, width: number, height: number];
const listingThumbnails: Partial<Record<string, Thumbnail>> = {
  'mechanical-maintainer-grace-period': ['/images/facility-qualifications/list-thumbnails/mechanical-maintainer-grace-period.webp', 1536, 1024],
  'refrigeration-safety-manager': ['/images/facility-qualifications/list-thumbnails/refrigeration-safety-manager.webp', 1536, 1024],
  'statutory-appointment-overlap': ['/images/facility-qualifications/list-thumbnails/statutory-appointment-overlap.webp', 1536, 1024],
  'musugi': ['/images/facility-career/list-thumbnails/musugi.webp', 1536, 1024],
  'facility-career-start': ['/images/facility-career/list-thumbnails/facility-career-start.webp', 1536, 1024],
  'hanfms': ['/images/facility-career/list-thumbnails/hanfms.webp', 1536, 1024],
  'kamcofmc': ['/images/facility-career/list-thumbnails/kamcofmc.webp', 1536, 1024],
  'korailtech': ['/images/facility-career/list-thumbnails/korailtech.webp', 1536, 1024],
  'postal-facilities': ['/images/facility-career/list-thumbnails/postal-facilities.webp', 1536, 1024],
  'sasugoldae': ['/images/facility-series/list-thumbnails-3x2/sasugoldae.webp', 1536, 1024],
  'hobyeongbaekma-mart-despair': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-mart-despair.webp', 1536, 1024],
  'hobyeongbaekma-mart-hope': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-mart-hope.webp', 1536, 1024],
  'hobyeongbaekma-department-store-despair': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-department-store-despair.webp', 1536, 1024],
  'hobyeongbaekma-department-store-hope': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-department-store-hope.webp', 1536, 1024],
  'hobyeongbaekma-hospital-despair': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-hospital-despair.webp', 1536, 1024],
  'hobyeongbaekma-hospital-hope': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-hospital-hope.webp', 1536, 1024],
  'hobyeongbaekma-hospital-large-university': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-hospital-large-university.webp', 1536, 1024],
  'hobyeongbaekma': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma.webp', 1536, 1024],
  'hobyeongbaekma-hotel-despair': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-hotel-despair.webp', 1536, 1024],
  'hobyeongbaekma-hotel-hope': ['/images/facility-series/list-thumbnails-3x2/hobyeongbaekma-hotel-hope.webp', 1536, 1024],
  'sasugoldae-sauna-hope': ['/images/facility-series/list-thumbnails-3x2/sasugoldae-sauna-hope.webp', 1536, 1024],
  'sasugoldae-university-hope': ['/images/facility-series/list-thumbnails-3x2/sasugoldae-university-hope.webp', 1536, 1024],
  'sasugoldae-university-despair': ['/images/facility-series/list-thumbnails-3x2/sasugoldae-university-despair.webp', 1536, 1024],
  'sasugoldae-golf-course-hope': ['/images/facility-series/list-thumbnails-3x2/sasugoldae-golf-course-hope.webp', 1536, 1024],
  'sasugoldae-golf-course-despair': ['/images/facility-series/list-thumbnails-3x2/sasugoldae-golf-course-despair.webp', 1536, 1024],
  'sasugoldae-swimming-pool-hope': ['/images/facility-series/list-thumbnails-3x2/sasugoldae-swimming-pool-hope.webp', 1536, 1024],
  'sasugoldae-swimming-pool-despair': ['/images/facility-series/list-thumbnails-3x2/sasugoldae-swimming-pool-despair.webp', 1536, 1024],
  'sasugoldae-sauna-despair': ['/images/facility-series/list-thumbnails-3x2/sasugoldae-sauna-despair.webp', 1536, 1024],
};
const defaultCover = covers[article.id];
const defaultCoverSize: readonly [number, number] = defaultCover?.startsWith('/images/facility-electric/') ? [1536, 1024]
  : article.id.startsWith('sasugoldae') ? [1448, 1086] : [1440, 1080];
const [cover, width, height] = listingThumbnails[article.id] ?? [defaultCover, ...defaultCoverSize];
---
<a class:list={['card', 'facility-card', { 'facility-card--lead': lead, 'facility-card--text': !cover }]} href={withBase(facilityArticlePath(article))}>
  {cover && <span class="facility-card-cover"><img src={withBase(cover)} alt="" width={width} height={height} loading={lead ? 'eager' : 'lazy'} decoding="async" /></span>}
  <span class="facility-card-content">
    <span class="facility-card-title">{article.data.title}</span>
    <span class="facility-card-description">{article.data.description}</span>
    {article.data.status === 'draft' && <span class="facility-card-meta">검토용 초안</span>}
  </span>
</a>
