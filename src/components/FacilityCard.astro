  'hobyeongbaekma-department-store-despair': '/images/facility-series/ep3-1-department-store-despair/01-hero.webp',
  'hobyeongbaekma-department-store-hope': '/images/facility-series/ep3-2-department-store-hope/01-hero.webp',
  'hobyeongbaekma-hospital-despair': '/images/facility-series/ep2-1-hospital-despair/01-hero.webp',
