---
import type { CollectionEntry } from 'astro:content';
import { facilityArticlePath } from '../config/facility';
import { withBase } from '../config/url';
interface Props { article: CollectionEntry<'facilityArticles'>; lead?: boolean; }
const { article, lead = false } = Astro.props;
// Published articles reuse their hero image by default; approved listing-only
// thumbnails override it without changing the article body or social metadata.
// A future article without a cover remains a text card.
const covers: Partial<Record<string, string>> = {
  'sasugoldae-sauna-despair': '/images/facility-series/sasugoldae-episodes/sasugoldae-sauna-despair.webp',
  'sasugoldae-sauna-hope': '/images/facility-series/sasugoldae-episodes/sasugoldae-sauna-hope.webp',
  'sasugoldae-swimming-pool-despair': '/images/facility-series/sasugoldae-episodes/sasugoldae-pool-despair.webp',
