---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface PracticeQuestion {
  id: string;
  label: string;
  number: number;
  body: string;
  choices: string[];
  answer: number;
  image?: { src: ImageMetadata; alt: string };
}
interface Props {
  questions: PracticeQuestion[];
  explanations: Record<string, string>;
}

const { questions, explanations } = Astro.props;
const practiceQuestions = questions.filter(question => Boolean(explanations[question.id]));
const symbols = ['①', '②', '③', '④'];
const imageChoicePattern = /^(수식|그림)[①②③④]$/;
const displayChoice = (choice: string, hasImage: boolean) => {
  if (!hasImage) return choice;
  const match = choice.match(imageChoicePattern);
  if (!match) return choice;
  return match[1] === '수식' ? '위 이미지에 제시된 수식' : '위 이미지에 제시된 보기';
};
---
{practiceQuestions.length > 0 && (
  <div class="instant-practice" data-instant-practice>
    <div class="practice-entry" data-practice-entry>
      <button
        type="button"
        class="practice-launch"
        data-practice-open
        aria-haspopup="dialog"
        aria-controls="instant-practice-dialog"
      >문제 풀기 ({practiceQuestions.length}문항)</button>
      <span>한 문제씩 풀이 · 즉시 채점과 해설</span>
    </div>
    <dialog
      id="instant-practice-dialog"
      class="instant-practice-dialog"
      data-practice-dialog
      aria-labelledby="instant-practice-heading"
      aria-modal="true"
    >
      <div class="practice-dialog-inner">
        <div class="practice-modal-header">
          <h2 id="instant-practice-heading">기출 한 문제씩 풀기</h2>
          <button type="button" class="practice-close" data-practice-close aria-label="문제 풀이 닫기">
            닫기 <span aria-hidden="true">×</span>
          </button>
        </div>
        <p class="practice-intro">답을 선택하고 정답을 확인하면 해설이 바로 표시됩니다.</p>
        <div class="practice-status-row">
          <span>연결 기출 {practiceQuestions.length}문항</span>
          <strong class="practice-progress" data-practice-progress>1 / {practiceQuestions.length}</strong>
        </div>
    {practiceQuestions.map((question, questionIndex) => (
      <section
        class="practice-item"
        data-practice-item
        data-answer={question.answer}
        hidden={questionIndex !== 0}
        aria-labelledby={'instant-question-' + questionIndex}
      >
        <p class="practice-meta">{question.label.replace(/ 시행$/, ' 시험')} · {question.number}번</p>
        <h3 id={'instant-question-' + questionIndex} tabindex="-1">{questionIndex + 1}. {question.body}</h3>
        {question.image && (
          <figure class="practice-figure">
            <Image
              src={question.image.src}
              alt={question.image.alt}
              width={question.image.src.width}
              height={question.image.src.height}
              loading="lazy"
              decoding="async"
            />
          </figure>
        )}
        <fieldset class="practice-choices">
          <legend class="sr-only">정답을 선택하세요</legend>
          {question.choices.map((choice, choiceIndex) => (
            <label class="practice-choice">
              <input
                type="radio"
                name={'instant-answer-' + questionIndex}
                value={choiceIndex + 1}
              />
              <span class="choice-symbol" aria-hidden="true">{symbols[choiceIndex]}</span>
              <span>{displayChoice(choice, Boolean(question.image))}</span>
            </label>
          ))}
        </fieldset>
        <button type="button" class="practice-button" data-practice-check disabled>정답 확인</button>
        <div class="practice-feedback" data-practice-feedback hidden aria-live="polite">
          <strong data-practice-result></strong>
          <p>정답: {symbols[question.answer - 1]} {displayChoice(question.choices[question.answer - 1], Boolean(question.image))}</p>
          <p><strong>해설</strong> — {explanations[question.id]}</p>
          <button type="button" class="practice-button" data-practice-next>
            {questionIndex === practiceQuestions.length - 1 ? '풀이 마치기' : '다음 문제 풀기 →'}
          </button>
        </div>
      </section>
    ))}
    <div class="practice-complete" data-practice-complete hidden aria-live="polite">
      <div class="practice-complete-symbol" aria-hidden="true">✓</div>
      <h3>연결 기출 풀이 완료</h3>
      <p class="practice-score" data-practice-score></p>
      <p class="practice-complete-description">틀린 문제도 다시 풀면서 개념을 복습해 보세요.</p>
      <div class="practice-complete-actions">
        <button type="button" class="practice-button" data-practice-restart>다시 풀기</button>
        <button type="button" class="practice-exit-button" data-practice-finish>학습으로 돌아가기</button>
      </div>
    </div>
      </div>
    </dialog>
  </div>
)}
<script>
  document.querySelectorAll<HTMLElement>('[data-instant-practice]').forEach(root => {
    const items = [...root.querySelectorAll<HTMLElement>('[data-practice-item]')];
    const progress = root.querySelector<HTMLElement>('[data-practice-progress]');
    const complete = root.querySelector<HTMLElement>('[data-practice-complete]');
    const score = root.querySelector<HTMLElement>('[data-practice-score]');
    const restart = root.querySelector<HTMLButtonElement>('[data-practice-restart]');
    const finish = root.querySelector<HTMLButtonElement>('[data-practice-finish]');
    const opener = document.querySelector<HTMLButtonElement>('[data-practice-open][aria-controls="instant-practice-dialog"]');
    const dialog = root.querySelector<HTMLDialogElement>('[data-practice-dialog]');
    const close = root.querySelector<HTMLButtonElement>('[data-practice-close]');
    const scrollArea = root.querySelector<HTMLElement>('.practice-dialog-inner');
    let correctCount = 0;

    // Rendered only for the pilot chapter. Move its launch control into the
    // existing question-history region without changing that shared component.
    const history = document.querySelector<HTMLElement>('[data-question-role="primary"]');
    const entry = root.querySelector<HTMLElement>('[data-practice-entry]');
    if (history && entry) history.append(entry);
    // Native dialogs stay in a browser top layer, but remain CSS descendants
    // of <article> unless moved. Keep the modal outside chapter typography.
    document.body.append(root);

    opener?.addEventListener('click', () => {
      if (!dialog || dialog.open) return;
      dialog.showModal();
      close?.focus();
    });

    close?.addEventListener('click', () => dialog?.close());
    finish?.addEventListener('click', () => dialog?.close());
    // A click on the backdrop is delivered to the dialog itself.
    dialog?.addEventListener('click', event => {
      if (event.target === dialog) dialog.close();
    });

    items.forEach((item, index) => {
      const radios = [...item.querySelectorAll<HTMLInputElement>('input[type="radio"]')];
      const check = item.querySelector<HTMLButtonElement>('[data-practice-check]');
      const feedback = item.querySelector<HTMLElement>('[data-practice-feedback]');
      const result = item.querySelector<HTMLElement>('[data-practice-result]');
      const next = item.querySelector<HTMLButtonElement>('[data-practice-next]');

      radios.forEach(radio => radio.addEventListener('change', () => {
        if (check && !item.dataset.graded) check.disabled = false;
      }));

      check?.addEventListener('click', () => {
        const selected = radios.find(radio => radio.checked);
        if (!selected || item.dataset.graded || !feedback || !result) return;

        const correctAnswer = Number(item.dataset.answer);
        const isCorrect = Number(selected.value) === correctAnswer;
        if (isCorrect) correctCount++;
        item.dataset.graded = 'true';

        radios.forEach(radio => {
          radio.disabled = true;
          if (Number(radio.value) === correctAnswer) radio.closest('label')?.classList.add('is-correct');
        });
        if (!isCorrect) selected.closest('label')?.classList.add('is-incorrect');
        result.textContent = isCorrect
          ? '정답입니다. 다음 문제를 풀어보세요.'
          : '오답입니다. 정답과 해설을 확인하세요.';
        result.className = isCorrect ? 'result-correct' : 'result-incorrect';
        check.hidden = true;
        feedback.hidden = false;
        next?.focus();
      });

      next?.addEventListener('click', () => {
        item.hidden = true;
        if (scrollArea) scrollArea.scrollTop = 0;
        const following = items[index + 1];
        if (following) {
          following.hidden = false;
          if (progress) progress.textContent = String(index + 2) + ' / ' + String(items.length);
          following.querySelector<HTMLElement>('h3')?.focus();
        } else {
          if (progress) progress.textContent = '완료';
          if (score) score.textContent = String(items.length) + '문제 중 ' + String(correctCount) + '문제 정답';
          if (complete) complete.hidden = false;
          restart?.focus();
        }
      });
    });

    const resetPractice = () => {
      correctCount = 0;
      items.forEach((item, index) => {
        item.hidden = index !== 0;
        delete item.dataset.graded;
        item.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach(radio => {
          radio.checked = false;
          radio.disabled = false;
          radio.closest('label')?.classList.remove('is-correct', 'is-incorrect');
        });
        const check = item.querySelector<HTMLButtonElement>('[data-practice-check]');
        if (check) {
          check.hidden = false;
          check.disabled = true;
        }
        const feedback = item.querySelector<HTMLElement>('[data-practice-feedback]');
        if (feedback) feedback.hidden = true;
      });
      if (complete) complete.hidden = true;
      if (progress) progress.textContent = '1 / ' + String(items.length);
      if (scrollArea) scrollArea.scrollTop = 0;
      items[0]?.querySelector<HTMLElement>('h3')?.focus();
    };

    restart?.addEventListener('click', resetPractice);
    // Escape, close button and backdrop click all restore focus and start a fresh session.
    dialog?.addEventListener('close', () => {
      resetPractice();
      opener?.focus({ preventScroll: true });
    });
  });
</script>
<style>
  .instant-practice{min-width:0}
  :global(.practice-entry){display:flex;align-items:center;gap:var(--space-3);flex-wrap:wrap;margin-top:var(--space-4)}
  :global(.practice-entry span){font-size:var(--fs-caption);color:var(--gray-600)}
  :global(.practice-launch),.practice-button{min-height:44px;padding:10px 16px;border:0;border-radius:var(--radius-md);background:var(--primary-600);color:var(--white);font:inherit;font-weight:var(--fw-semibold);cursor:pointer}
  :global(.practice-launch:focus-visible),.practice-button:focus-visible,.practice-close:focus-visible,.practice-exit-button:focus-visible{outline:3px solid var(--primary-100);outline-offset:3px}
  .instant-practice-dialog{box-sizing:border-box;width:min(720px,calc(100vw - 32px));max-width:none;max-height:calc(100dvh - 32px);margin:auto;padding:0;border:1px solid var(--gray-200);border-radius:var(--radius-xl);box-shadow:0 16px 48px rgba(25,31,40,.2);background:var(--white);color:var(--gray-800);font-family:var(--font-sans)}
  .instant-practice-dialog::backdrop{background:rgba(25,31,40,.6)}
  .practice-dialog-inner{box-sizing:border-box;padding:var(--space-6);max-height:calc(100dvh - 32px);overflow-y:auto;overscroll-behavior:contain}
  .practice-modal-header{display:flex;align-items:center;justify-content:space-between;gap:var(--space-3)}
  .practice-modal-header h2{display:block;flex:1;min-width:0;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:var(--gray-900);font-size:var(--fs-h3);font-weight:var(--fw-bold);line-height:1.4;letter-spacing:-.02em;word-break:keep-all}
  .practice-modal-header h2::before{display:none;content:none}
  .practice-close{display:inline-flex;flex:none;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:8px 12px;border:1px solid var(--gray-200);border-radius:var(--radius-md);background:var(--white);color:var(--gray-800);font:inherit;font-size:var(--fs-caption);cursor:pointer}
  .practice-close span{font-size:18px;line-height:1}
  .practice-intro{margin:var(--space-3) 0 var(--space-4);font-size:var(--fs-caption);line-height:1.6;color:var(--gray-600)}
  .practice-status-row{display:flex;justify-content:space-between;align-items:center;gap:var(--space-3);padding:var(--space-3) 0;margin-bottom:var(--space-5,20px);border-top:1px solid var(--gray-200);border-bottom:1px solid var(--gray-200);font-size:var(--fs-caption);color:var(--gray-600)}
  .practice-progress{flex:none;white-space:nowrap;padding:4px 10px;border-radius:var(--radius-full);background:var(--primary-50);color:var(--primary-700);font-size:var(--fs-caption);font-weight:var(--fw-semibold)}
  .practice-item[hidden],.practice-feedback[hidden],.practice-complete[hidden]{display:none!important}
  .practice-meta{color:var(--gray-600);font-size:var(--fs-caption);margin:0 0 var(--space-3)}
  .practice-item h3{margin:0 0 var(--space-4);font-size:var(--fs-h3);line-height:1.55;color:var(--gray-900);overflow-wrap:anywhere}
  .practice-item h3:focus-visible{outline:2px solid var(--primary-600);outline-offset:4px}
  .practice-figure{margin:0 0 var(--space-4)}
  .practice-figure img{display:block;max-width:100%;height:auto}
  .practice-choices{padding:0;margin:0 0 var(--space-4);border:0;display:grid;gap:var(--space-2);min-width:0}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  .practice-choice{display:flex;gap:var(--space-3);align-items:flex-start;border:1px solid var(--gray-200);border-radius:var(--radius-md);padding:var(--space-3);font-size:var(--fs-body);line-height:1.6;cursor:pointer;min-width:0;overflow-wrap:anywhere}
  .practice-choice:has(input:checked){border-color:var(--primary-600);background:var(--primary-50)}
  .practice-choice:has(input:focus-visible){outline:2px solid var(--primary-600);outline-offset:2px}
  .practice-choice input{margin:5px 0 0;accent-color:var(--primary-600);flex:none}
  .choice-symbol{flex:none;font-weight:var(--fw-semibold)}
  .practice-choice.is-correct{border-color:var(--success);background:var(--success-bg)}
  .practice-choice.is-incorrect{border-color:var(--error);background:var(--error-bg)}
  .practice-button:disabled{background:var(--gray-200);color:var(--gray-600);cursor:not-allowed}
  .practice-feedback{margin-top:var(--space-4);padding:var(--space-4);border-radius:var(--radius-lg);background:var(--gray-50);overflow-wrap:anywhere}
  .practice-feedback p{margin:var(--space-2) 0;font-size:var(--fs-body)}
  .practice-feedback .practice-button{margin-top:var(--space-3)}
  .result-correct{color:#047857}
  .result-incorrect{color:#B91C1C}
  .practice-complete{padding:var(--space-6) var(--space-4);border:1px solid var(--gray-200);border-radius:var(--radius-lg);background:var(--gray-50);text-align:center}
  .practice-complete-symbol{display:grid;place-items:center;width:48px;height:48px;margin:0 auto var(--space-3);border-radius:50%;background:var(--success-bg);color:#047857;font-size:26px;font-weight:var(--fw-bold)}
  .practice-complete h3{margin:0 0 var(--space-2);font-size:var(--fs-h3);color:var(--gray-900);line-height:1.5}
  .practice-score{margin:0;color:var(--primary-700);font-size:var(--fs-h3);font-weight:var(--fw-bold)}
  .practice-complete-description{margin:var(--space-3) 0 var(--space-6);font-size:var(--fs-caption);color:var(--gray-600)}
  .practice-complete-actions{display:flex;justify-content:center;gap:var(--space-2);flex-wrap:wrap}
  .practice-exit-button{min-height:44px;padding:10px 16px;border:1px solid var(--gray-200);border-radius:var(--radius-md);background:var(--white);color:var(--gray-800);font:inherit;font-weight:var(--fw-semibold);cursor:pointer}
  @media(max-width:480px){
    .instant-practice-dialog{width:calc(100vw - 24px);max-height:calc(100dvh - 24px)}
    .practice-dialog-inner{padding:var(--space-4);max-height:calc(100dvh - 24px)}
    .practice-modal-header{gap:var(--space-2)}
    .practice-modal-header h2{font-size:18px}
    .practice-close{padding:8px 10px}
    .practice-button{width:100%}
    .practice-complete{padding:var(--space-6) var(--space-3)}
    .practice-complete-actions{flex-direction:column}
    .practice-exit-button{width:100%}
    :global(.practice-entry){align-items:stretch}
  }
</style>