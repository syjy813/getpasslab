---
// 160×600 PC 세로 광고단위를 AdFit에서 생성한 후 발급된 DAN- 코드를 입력합니다.
// ID가 없을 때 Production에서는 광고 요청·빈 광고 영역 모두 표시하지 않습니다.
const floatingUnit = '';
---

<aside
  class="adfit-floating"
  data-adfit-floating
  data-adfit-unit={floatingUnit}
  aria-label="광고"
>
  <div class="adfit-floating-header">
    <span>광고</span>
    <button type="button" class="adfit-floating-close" data-adfit-close aria-label="광고 닫기">×</button>
  </div>
  <div class="adfit-floating-mount" data-adfit-mount>
    <div class="adfit-floating-preview" data-adfit-preview aria-hidden="true">
      <span>광고 영역 미리보기</span>
      <span>160 × 600</span>
    </div>
  </div>
</aside>

<script is:inline>
  (() => {
    const placement = document.querySelector('[data-adfit-floating]');
    if (!(placement instanceof HTMLElement)) return;

    const isProduction = window.location.hostname === 'getpasslab.co.kr';
    const unit = placement.dataset.adfitUnit || '';
    // AdFit 세로 광고단위가 발급되기 전에는 Production에 빈 배너를 표시하지 않습니다.
    if (isProduction && !/^DAN-[A-Za-z0-9]+$/.test(unit)) return;

    const viewport = window.matchMedia('(min-width: 1600px) and (min-height: 760px)');
    const storageKey = 'getpasslab-adfit-floating-dismissed';
    const mount = placement.querySelector('[data-adfit-mount]');
    const closeButton = placement.querySelector('[data-adfit-close]');
    if (!(mount instanceof HTMLElement) || !(closeButton instanceof HTMLButtonElement)) return;

    let dismissed = false;
    try {
      dismissed = window.sessionStorage.getItem(storageKey) === '1';
    } catch {
      // 저장소 사용이 제한된 환경에서는 현재 페이지에서만 닫기 상태를 적용합니다.
    }
    if (dismissed) return;

    closeButton.addEventListener('click', () => {
      dismissed = true;
      placement.dataset.adfitClosed = 'true';
      try {
        window.sessionStorage.setItem(storageKey, '1');
      } catch {
        // 닫기 동작 자체는 항상 유지합니다.
      }
    });

    const initializeAd = () => {
      if (placement.dataset.adfitMounted) return;
      placement.dataset.adfitMounted = 'true';
      mount.querySelector('[data-adfit-preview]')?.remove();

      const ad = document.createElement('ins');
      ad.className = 'kakao_ad_area';
      ad.style.display = 'none';
      ad.dataset.adUnit = unit;
      ad.dataset.adWidth = '160';
      ad.dataset.adHeight = '600';
      mount.appendChild(ad);

      const sdk = document.createElement('script');
      sdk.type = 'text/javascript';
      sdk.src = 'https://t1.kakaocdn.net/kas/static/ba.min.js';
      sdk.async = true;
      mount.appendChild(sdk);
    };

    const updateVisibility = () => {
      if (!viewport.matches || dismissed) return;
      placement.dataset.adfitReady = 'true';
      // 개발/미리보기 도메인에서는 실제 AdFit 요청 없이 자리만 확인합니다.
      if (isProduction) initializeAd();
    };

    viewport.addEventListener('change', updateVisibility);
    updateVisibility();
  })();
</script>

<style>
  .adfit-floating {
    display: none;
    position: fixed;
    top: calc(var(--gnb-h) + var(--space-4));
    right: max(var(--space-4), calc((100vw - var(--container-max)) / 2 - 176px));
    z-index: 30;
    width: 160px;
    margin: 0;
  }

  .adfit-floating-header {
    display: flex;
    height: 28px;
    margin-bottom: var(--space-2);
    justify-content: space-between;
    align-items: center;
    color: var(--gray-600);
    font-size: var(--fs-label);
  }

  .adfit-floating-close {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 1px solid var(--gray-200);
    border-radius: var(--radius-sm);
    background: var(--white);
    color: var(--gray-800);
    font: inherit;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }

  .adfit-floating-close:hover { background: var(--gray-100); }
  .adfit-floating-close:focus-visible {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
  }

  .adfit-floating-mount {
    width: 160px;
    height: 600px;
  }

  .adfit-floating-preview {
    display: grid;
    width: 160px;
    height: 600px;
    place-content: center;
    gap: 8px;
    border: 1px dashed var(--gray-200);
    border-radius: var(--radius-md);
    background: var(--white);
    color: var(--gray-600);
    font-size: var(--fs-caption);
    text-align: center;
  }

  @media (min-width: 1600px) and (min-height: 760px) {
    .adfit-floating[data-adfit-ready='true']:not([data-adfit-closed='true']) {
      display: block;
    }
  }
</style>
