---
import { getCertificationEntryPath, getFeaturedCertifications } from '../config/certifications';
import { withBase } from '../config/url';
const certifications = getFeaturedCertifications();
---
<header class="gnb">
  <nav class="gnb-inner">
    <a href={withBase('/')} class="gnb-logo">GetPassLab</a>
    <div class="gnb-spacer"></div>
    <details class="gnb-menu">
      <summary>자격증 · 과목
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
      </summary>
      <div class="gnb-dropdown">
        {certifications.map((certification) => (
          <div class="gnb-certification">
            <a class="gnb-certification-link" href={withBase(getCertificationEntryPath(certification.slug))}>{certification.name}</a>
            {Object.values(certification.exams).map((exam) => (
              Object.entries(exam.subjects).map(([id, subject]) => (
                <a href={withBase(`/${certification.slug}/${exam.slug}/${subject.slug}/`)}>
                  {subject.label ?? `${id}과목`} · {subject.name}
                </a>
              ))
            ))}
          </div>
        ))}
      </div>
    </details>
  </nav>
</header>
<script>
  document.querySelectorAll('.gnb-menu').forEach(d => {
    document.addEventListener('click', e => {
      if (d instanceof HTMLDetailsElement && d.open && !d.contains(e.target as Node)) d.open = false;
    });
  });
</script>
