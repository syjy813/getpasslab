---
import '../styles/global.css';
import GNB from '../components/GNB.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../config/url';
import { SITE } from '../config/site';

interface Props {
  title: string;
  description: string;
  robots?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description,
  robots = 'index, follow',
  ogType = 'website',
  structuredData = [],
  bodyClass,
} = Astro.props;
const siteOrigin = Astro.site ?? SITE.url;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const ogImageUrl = new URL('/og-default.png', siteOrigin);
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'ko-KR',
  },
  ...pageStructuredData,
];
const serializeJsonLd = (value: Record<string, unknown>) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="naver-site-verification" content="834fae8c1cc760d91edf091099fa8e1d22c7085b" />
    <script
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8799723694540263"
      crossorigin="anonymous"
    ></script>
    <script is:inline>
      (() => {
        const measurementId = 'G-0CB3KFL9FJ';
        const hostname = window.location.hostname;
        const isLocalhost =
          hostname === 'localhost' ||
          hostname.endsWith('.localhost') ||
          ['127.0.0.1', '0.0.0.0', '::1', '[::1]'].includes(hostname);

        if (isLocalhost) {
          window[`ga-disable-${measurementId}`] = true;
          return;
        }

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', measurementId);

        const analyticsScript = document.createElement('script');
        analyticsScript.async = true;
        analyticsScript.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
        document.head.appendChild(analyticsScript);
      })();
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase('/favicon-approved-v1.png')} type="image/png" sizes="96x96" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GetPassLab 자격증 핵심요약 학습 서비스" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  </head>
  <body class={bodyClass}>
    <GNB />
    <slot />
    <Footer />
  </body>
</html>
