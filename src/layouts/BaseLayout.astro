---
import '../styles/global.css';
import '../styles/catalog.css';
import GNB from '../components/GNB.astro';
import type { ChapterNavigationGroup } from '../components/GNB.astro';
import Footer from '../components/Footer.astro';
import AdFitFloating from '../components/AdFitFloating.astro';
import { withBase } from '../config/url';
import { SITE } from '../config/site';
import { getFeaturedCertifications } from '../config/certifications';

interface Props {
  title: string;
  description: string;
  robots?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  bodyClass?: string;
  focusMode?: boolean;
  chapterNavigation?: ChapterNavigationGroup[];
  mobileTopAd?: boolean;
}

const {
  title,
  description,
  robots = 'index, follow',
  ogType = 'website',
  structuredData = [],
  bodyClass,
  focusMode = false,
  chapterNavigation,
  mobileTopAd = false,
} = Astro.props;
const pathname = Astro.url.pathname;
const hasContentFooterAd = !focusMode && (
  pathname === withBase('/') || getFeaturedCertifications().some(cert =>
    pathname.startsWith(withBase(`/${cert.slug}/`)) && !pathname.includes('/practice/')
  )
);
const swapMobileAds = mobileTopAd && hasContentFooterAd;
const siteOrigin = Astro.site ?? SITE.url;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const ogImageUrl = new URL('/og-default.png', siteOrigin);
const pageStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    inLanguage: 'ko-KR',
  },
  ...pageStructuredData,
];
const serializeJsonLd = (value: Record<string, unknown>) =>
  JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="naver-site-verification" content="834fae8c1cc760d91edf091099fa8e1d22c7085b" />
    <script is:inline>
      (() => {
        const measurementId = 'G-0CB3KFL9FJ';
        const hostname = window.location.hostname;
        const isLocalhost =
          hostname === 'localhost' ||
          hostname.endsWith('.localhost') ||
          ['127.0.0.1', '0.0.0.0', '::1', '[::1]'].includes(hostname);

        if (isLocalhost) {
          window[`ga-disable-${measurementId}`] = true;
          return;
        }

        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', measurementId);

        const analyticsScript = document.createElement('script');
        analyticsScript.async = true;
        analyticsScript.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
        document.head.appendChild(analyticsScript);
      })();
    </script>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase('/favicon-approved-v1.png')} type="image/png" sizes="96x96" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="GetPassLab 자격증 핵심요약 학습 서비스" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={serializeJsonLd(data)} />
    ))}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  </head>
  <body class={bodyClass}>
    {!focusMode && <GNB chapterNavigation={chapterNavigation} />}
    {swapMobileAds && (
      <aside class="footer-ad mobile-entry-ad" style="padding-top:var(--space-2)" data-mobile-entry-ad aria-label="광고" hidden>
        <span class="footer-ad-label">광고</span>
        <div class="footer-ad-mount" data-mobile-entry-ad-mount></div>
        <script is:inline>
          (() => {
            const placement = document.querySelector('[data-mobile-entry-ad]');
            const mount = placement?.querySelector('[data-mobile-entry-ad-mount]');
            if (!(placement instanceof HTMLElement) || !(mount instanceof HTMLElement)) return;
            const initialize = () => {
              const viewportWidth = document.documentElement.clientWidth;
              const available = Math.min(viewportWidth, placement.parentElement.clientWidth);
              const active = window.innerWidth >= 320 && window.innerWidth <= 767 && available >= 300;
              placement.hidden = !active;
              if (!active) {
                if (placement.dataset.adfitReady === 'true') {
                  mount.replaceChildren();
                  delete placement.dataset.adfitReady;
                }
                return;
              }
              if (placement.dataset.adfitReady) return;
              if (window.location.hostname !== 'getpasslab.co.kr') {
                placement.dataset.adfitReady = 'preview';
                return;
              }
              placement.dataset.adfitReady = 'true';
              const ad = document.createElement('ins');
              ad.className = 'kakao_ad_area';
              ad.style.display = 'none';
              ad.dataset.adUnit = 'DAN-A3dGUv2kIjnZSTmZ';
              ad.dataset.adWidth = '300';
              ad.dataset.adHeight = '250';
              mount.appendChild(ad);
              const sdk = document.createElement('script');
              sdk.type = 'text/javascript';
              sdk.src = '//t1.kakaocdn.net/kas/static/ba.min.js';
              sdk.async = true;
              mount.appendChild(sdk);
            };
            initialize();
            new ResizeObserver(initialize).observe(document.documentElement);
          })();
        </script>
      </aside>
    )}
    <slot />
    {!focusMode && mobileTopAd && (
      <aside class="mobile-top-ad" aria-label="광고" data-mobile-top-ad>
        <span class="mobile-top-ad-label">광고</span>
        <div class="mobile-top-ad-mount" data-mobile-top-ad-mount></div>
        <script is:inline>
          (() => {
            const placement = document.querySelector('[data-mobile-top-ad]');
            const mount = placement?.querySelector('[data-mobile-top-ad-mount]');
            if (!(placement instanceof HTMLElement) || !(mount instanceof HTMLElement)) return;
            const mobile = window.matchMedia('(min-width:320px) and (max-width:767px)');
            const initialize = () => {
              const fitsViewport = document.documentElement.clientWidth >= 320;
              placement.toggleAttribute('data-adfit-unavailable', !fitsViewport);
              if (!fitsViewport) return;
              if (!mobile.matches || placement.dataset.adfitReady || mount.getBoundingClientRect().width < 320) return;
              if (window.location.hostname !== 'getpasslab.co.kr') {
                placement.dataset.adfitReady = 'preview';
                return;
              }
              placement.dataset.adfitReady = 'true';
              const ad = document.createElement('ins');
              ad.className = 'kakao_ad_area';
              ad.style.display = 'none';
              ad.dataset.adUnit = 'DAN-aX4OBdYehvddWlai';
              ad.dataset.adWidth = '320';
              ad.dataset.adHeight = '50';
              mount.appendChild(ad);
              const sdk = document.createElement('script');
              sdk.type = 'text/javascript';
              sdk.src = '//t1.kakaocdn.net/kas/static/ba.min.js';
              sdk.async = true;
              mount.appendChild(sdk);
            };
            initialize();
            mobile.addEventListener('change', initialize);
            // A loaded fixed-width unit must also fit after a resize or scrollbar change.
            new ResizeObserver(initialize).observe(document.documentElement);
          })();
        </script>
      </aside>
    )}
    {hasContentFooterAd && (
      <aside class="footer-ad" data-footer-ad data-unit="DAN-A3dGUv2kIjnZSTmZ" data-desktop-unit="DAN-cUOTdTkWFtH2f3C1" data-mobile-swapped={swapMobileAds ? "true" : undefined} aria-label="광고" hidden>
        <span class="footer-ad-label">광고</span>
        <div class="footer-ad-mount" data-footer-ad-mount></div>
        <script is:inline>
          (() => {
            const placement = document.querySelector('[data-footer-ad]');
            const mount = placement?.querySelector('[data-footer-ad-mount]');
            if (!(placement instanceof HTMLElement) || !(mount instanceof HTMLElement)) return;
            const initialize = () => {
              const available = Math.min(document.documentElement.clientWidth, placement.parentElement.clientWidth);
              const desktop = document.documentElement.clientWidth >= 1024;
              const width = desktop ? 728 : 300;
              const height = desktop ? 90 : 250;
              const size = desktop ? 'desktop' : 'mobile';
              const swappedMobile = placement.dataset.mobileSwapped === 'true' && document.documentElement.clientWidth <= 767;
              placement.hidden = swappedMobile || available < width;
              if (placement.hidden) {
                if (swappedMobile && mount.childElementCount) {
                  mount.replaceChildren();
                  delete placement.dataset.footerAdReady;
                }
                return;
              }
              if (placement.dataset.footerAdSize === size && placement.dataset.footerAdReady) return;
              placement.dataset.footerAdSize = size;
              delete placement.dataset.footerAdReady;
              mount.replaceChildren();
              if (window.location.hostname !== 'getpasslab.co.kr') {
                placement.dataset.footerAdReady = 'preview';
                return;
              }
              placement.dataset.footerAdReady = 'true';
              const ad = document.createElement('ins');
              ad.className = 'kakao_ad_area';
              ad.style.display = 'none';
              ad.dataset.adUnit = desktop ? placement.dataset.desktopUnit : placement.dataset.unit;
              ad.dataset.adWidth = String(width);
              ad.dataset.adHeight = String(height);
              mount.appendChild(ad);
              const sdk = document.createElement('script');
              sdk.type = 'text/javascript';
              sdk.src = '//t1.kakaocdn.net/kas/static/ba.min.js';
              sdk.async = true;
              mount.appendChild(sdk);
            };
            initialize();
            new ResizeObserver(initialize).observe(document.documentElement);
          })();
        </script>
      </aside>
    )}
    {!focusMode && <Footer />}
    {!focusMode && <AdFitFloating />}
  </body>
</html>

<style>
  .footer-ad{box-sizing:border-box;display:flex;width:100%;padding-top:var(--space-8);flex-direction:column;align-items:center}
  .mobile-top-ad[data-adfit-unavailable]{display:none}
  .footer-ad[hidden]{display:none}
  .footer-ad-label{margin-bottom:var(--space-2);font-size:var(--fs-label);line-height:1;color:var(--gray-600)}
  .footer-ad-mount{width:300px;height:250px;flex:none}
  .footer-ad[data-footer-ad-size="desktop"] .footer-ad-mount{width:728px;height:90px}
</style>
