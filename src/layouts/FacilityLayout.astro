---
import BaseLayout from './BaseLayout.astro';
import '../styles/facility.css';
interface Props {
  title: string;
  description: string;
  robots?: string;
  ogType?: 'website' | 'article';
  structuredData?: Record<string, unknown>[];
}
---
<BaseLayout {...Astro.props} bodyClass="facility-page" ogImagePath="/og-facility.png" ogImageAlt="GetPassLab 시설의 모든 것: 취업, 법정선임, 시설관리 실무 정보" >
  <main id="main-content" class="container facility-main"><slot /></main>
</BaseLayout>
