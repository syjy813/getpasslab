---
import BaseLayout from './BaseLayout.astro';
import { SUBJECTS, type SubjectId } from '../config/subjects';
import { withBase } from '../config/url';
import ChapterBadges from '../components/ChapterBadges.astro';
import type { ChapterBadge } from '../utils/chapterBadges';
import { SITE } from '../config/site';
interface SideCh { slug: string; title: string; group: string; }
interface Props {
  title: string; summary: string; subject_id: number; group: string;
  badges: ChapterBadge[];
  sideChapters: SideCh[];
}
const { title, summary, subject_id, group, badges, sideChapters } = Astro.props;
const subject = SUBJECTS[subject_id as SubjectId];
const subjectUrl = withBase(`/industrial-safety/written/${subject.slug}/`);
const groups = [...new Set(sideChapters.map(c => c.group))];
const fullPageTitle = `${title} — ${subject.name} — 산업안전기사 필기 | GetPassLab`;
const pageTitle = fullPageTitle.length <= 60
  ? fullPageTitle
  : `${title} — 산업안전기사 필기 | GetPassLab`;
const normalizedSummary = summary.replace(/[.!?]+$/u, '').trim();
const typeBadge = badges.find((badge) => badge.tone === 'type')?.label;
const hasLegalBadge = badges.some((badge) => badge.tone === 'legal');
const seoDetail = hasLegalBadge
  ? '법령 기준과 적용 조건, 시험 포인트와 주의사항을 정리합니다.'
  : typeBadge === '계산'
    ? '계산 공식과 적용 순서, 단위·조건 및 자주 틀리는 포인트를 정리합니다.'
    : typeBadge === '절차'
      ? '작업 순서와 판단 기준, 시험 포인트 및 주의사항을 정리합니다.'
      : '핵심 정의와 판별 기준, 시험 포인트와 자주 틀리는 내용을 정리합니다.';
const seoDescription = `${title}: ${normalizedSummary}. 산업안전기사 필기 ${subject.name} 기출을 바탕으로 ${seoDetail}`;
const siteOrigin = Astro.site ?? SITE.url;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const breadcrumbItems = [
  { name: '홈', url: new URL('/', siteOrigin).toString() },
  { name: '산업안전기사', url: new URL('/industrial-safety/', siteOrigin).toString() },
  { name: '필기', url: new URL('/industrial-safety/written/', siteOrigin).toString() },
  { name: subject.name, url: new URL(`/industrial-safety/written/${subject.slug}/`, siteOrigin).toString() },
  { name: title, url: canonicalUrl },
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: title,
    description: seoDescription,
    url: canonicalUrl,
    inLanguage: 'ko-KR',
    educationalLevel: '산업안전기사 필기',
    learningResourceType: '핵심요약',
    about: subject.name,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE.name,
      url: SITE.url,
    },
  },
];
---
<BaseLayout title={pageTitle} description={seoDescription} ogType="article" structuredData={structuredData}>
  <div class="chapter-wrap">
    <aside class="chapter-side">
      <div class="side-sticky">
        <div class="gpl-caption" style="margin-bottom:var(--space-2)">{subject_id}과목 · 챕터 목록</div>
        <nav class="side-nav">
          {groups.map(g => (
            <>
              <div class="side-group">{g}</div>
              {sideChapters.filter(c => c.group === g).map(c => (
                <a href={withBase(`/industrial-safety/written/${subject.slug}/${c.slug}/`)} class={c.title === title ? 'active' : ''}>{c.title}</a>
              ))}
            </>
          ))}
        </nav>
      </div>
    </aside>
    <main style="min-width:0">
      <nav class="breadcrumb">
        <a href={withBase('/')}>홈</a><span class="sep">/</span>
        <a href={withBase('/industrial-safety/')}>산업안전기사</a><span class="sep">/</span>
        <a href={withBase('/industrial-safety/written/')}>필기</a><span class="sep">/</span>
        <a href={subjectUrl}>{subject_id}과목</a><span class="sep">/</span>
        <span class="current">{title}</span>
      </nav>
      <ChapterBadges badges={badges} class="chapter-title-badges" />
      <h1 class="gpl-display">{title}</h1>
      <p class="gpl-body-lg" style="color:var(--gray-600);margin:var(--space-2) 0 var(--space-6)">{summary}</p>
      <article><slot /></article>
    </main>
  </div>
</BaseLayout>
