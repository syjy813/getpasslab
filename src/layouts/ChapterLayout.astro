---
import '../styles/learningFigures.css';
import '../styles/industrialReadability.css';
import BaseLayout from './BaseLayout.astro';
import {
  getCertification,
  getExamEntryPath,
  getExam,
  getSubject,
  getSubjectLabel,
} from '../config/certifications';
import { withBase } from '../config/url';
import ChapterBadges from '../components/ChapterBadges.astro';
import InstantQuestionPractice from '../components/InstantQuestionPractice.astro';
import type { ChapterBadge } from '../utils/chapterBadges';
import { SITE } from '../config/site';
interface SideCh { slug: string; title: string; group: string; }
interface SubjectStartChapter { subjectId: number; chapterSlug: string; }
interface Props {
  title: string; slug: string; summary: string; cert_id: string; exam: string;
  subject_id: number; group: string; questions?: string[];
  badges: ChapterBadge[];
  sideChapters: SideCh[];
  subjectStartChapters: SubjectStartChapter[];
  practiceQuestions?: any[];
}
const {
  title,
  slug,
  summary,
  cert_id,
  exam,
  subject_id,
  questions = [],
  badges,
  sideChapters,
  subjectStartChapters,
  practiceQuestions,
} = Astro.props;
const certification = getCertification(cert_id);
const examDefinition = getExam(cert_id, exam);
const subject = getSubject(cert_id, exam, subject_id);
if (!certification || !examDefinition || !subject) {
  throw new Error(`Unknown chapter scope: ${cert_id}/${exam}/${subject_id}`);
}
const subjectLabel = getSubjectLabel(subject_id, subject);
const isSingleSubjectExam = Object.keys(examDefinition.subjects).length === 1;
const routePrefix = `/${certification.slug}/${examDefinition.slug}`;
const subjectUrl = withBase(`${routePrefix}/${subject.slug}/`);
const examEntryUrl = withBase(getExamEntryPath(certification.slug, examDefinition.slug));
const subjectSwitchItems = Object.entries(examDefinition.subjects).flatMap(([id, itemSubject]) => {
  const itemSubjectId = Number(id);
  const startChapter = subjectStartChapters.find(item => item.subjectId === itemSubjectId);
  if (!startChapter) return [];

  return [{
    subjectId: itemSubjectId,
    label: getSubjectLabel(itemSubjectId, itemSubject),
    name: itemSubject.name,
    url: withBase(`${routePrefix}/${itemSubject.slug}/${startChapter.chapterSlug}/`),
  }];
});
const groups = [...new Set(sideChapters.map(c => c.group))];
const navigableChapters = groups.flatMap(group =>
  sideChapters.filter(chapter => chapter.group === group),
);
const currentChapterIndex = navigableChapters.findIndex(chapter => chapter.slug === slug);
if (currentChapterIndex === -1) {
  throw new Error(`Current chapter is missing from subject navigation: ${slug}`);
}
const previousChapter = navigableChapters[currentChapterIndex - 1];
const nextChapter = navigableChapters[currentChapterIndex + 1];
const chapterUrl = (chapter: SideCh) =>
  withBase(`${routePrefix}/${subject.slug}/${chapter.slug}/`);
const fullPageTitle = `${title} — ${subject.name} — ${certification.name} ${examDefinition.name} | GetPassLab`;
const pageTitle = fullPageTitle.length <= 60
  ? fullPageTitle
  : `${title} — ${certification.name} ${examDefinition.name} | GetPassLab`;
const normalizedSummary = summary.replace(/[.!?]+$/u, '').trim();
const typeBadge = badges.find((badge) => badge.tone === 'type')?.label;
const hasLegalBadge = badges.some((badge) => badge.tone === 'legal');
const seoDetail = hasLegalBadge
  ? '법령 기준과 적용 조건, 시험 포인트와 주의사항을 정리합니다.'
  : typeBadge === '계산'
    ? '계산 공식과 적용 순서, 단위·조건 및 자주 틀리는 포인트를 정리합니다.'
    : typeBadge === '절차'
      ? '작업 순서와 판단 기준, 시험 포인트 및 주의사항을 정리합니다.'
      : '핵심 정의와 판별 기준, 시험 포인트와 자주 틀리는 내용을 정리합니다.';
const sourceContext = questions.length > 0
  ? '기출을 바탕으로'
  : '현행 출제기준에 맞춰';
const seoDescription = `${title}: ${normalizedSummary}. ${certification.name} ${examDefinition.name} ${subject.name} ${sourceContext} ${seoDetail}`;
const siteOrigin = Astro.site ?? SITE.url;
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).toString();
const breadcrumbItems = [
  { name: '홈', url: new URL('/', siteOrigin).toString() },
  { name: certification.name, url: new URL(`/${certification.slug}/`, siteOrigin).toString() },
  { name: examDefinition.name, url: new URL(`${routePrefix}/`, siteOrigin).toString() },
  ...(!isSingleSubjectExam
    ? [{ name: subject.name, url: new URL(`${routePrefix}/${subject.slug}/`, siteOrigin).toString() }]
    : []),
  { name: title, url: canonicalUrl },
];
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      item: item.url,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'LearningResource',
    name: title,
    description: seoDescription,
    url: canonicalUrl,
    inLanguage: 'ko-KR',
    educationalLevel: `${certification.name} ${examDefinition.name}`,
    learningResourceType: '핵심요약',
    about: subject.name,
    isPartOf: {
      '@type': 'WebSite',
      name: SITE.name,
      url: SITE.url,
    },
  },
];
---
<BaseLayout
  title={pageTitle}
  description={seoDescription}
  ogType="article"
  structuredData={structuredData}
  chapterNavigation={groups.map(group => ({
    group,
    chapters: sideChapters.filter(c => c.group === group).map(c => ({
      title: c.title,
      href: chapterUrl(c),
      current: c.slug === slug,
    })),
  }))}
  bodyClass={`chapter-page${cert_id === 'industrial-safety' ? ' industrial-safety-chapter' : ''}${cert_id === 'industrial-safety' && slug === 'boiler-safety-devices' ? ' reading-pilot' : ''}`}
  mobileTopAd={examDefinition.slug === 'written'}
>
  <div class="chapter-wrap">
    <aside class="chapter-side">
      <div class="side-sticky">
        <div class="gpl-caption" style="margin-bottom:var(--space-2)">{isSingleSubjectExam ? '챕터 목록' : `${subjectLabel} · 챕터 목록`}</div>
        <nav class="side-nav">
          {groups.map(g => (
            <>
              <div class="side-group">{g}</div>
              {sideChapters.filter(c => c.group === g).map(c => (
                <a
                  href={chapterUrl(c)}
                  class={c.slug === slug ? 'active' : ''}
                  aria-current={c.slug === slug ? 'page' : undefined}
                >
                  {c.title}
                </a>
              ))}
            </>
          ))}
        </nav>
      </div>
    </aside>
    <main style="min-width:0">
      <nav class="breadcrumb">
        <a href={withBase('/')}>홈</a><span class="sep">/</span>
        <span>{certification.name}</span><span class="sep">/</span>
        <a href={examEntryUrl}>{examDefinition.name}</a>
        {!isSingleSubjectExam && (
          <>
            <span class="sep">/</span>
            {subjectSwitchItems.length > 1 ? (
              <details class="subject-switcher">
                <summary aria-label={`${subjectLabel} 전환`}>
                  <span>{subjectLabel}</span>
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m6 9 6 6 6-6"></path>
                  </svg>
                </summary>
                <div class="subject-switcher-menu" aria-label="과목 목록">
                  {subjectSwitchItems.map(item => item.subjectId === subject_id ? (
                    <span class="subject-switcher-item current" aria-current="page">
                      <span class="subject-switcher-label">{item.label}</span>
                      <span>{item.name}</span>
                    </span>
                  ) : (
                    <a class="subject-switcher-item" href={item.url}>
                      <span class="subject-switcher-label">{item.label}</span>
                      <span>{item.name}</span>
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a href={subjectUrl}>{subjectLabel}</a>
            )}
          </>
        )}
        <span class="sep breadcrumb-current-sep">/</span>
        <span class="current">{title}</span>
      </nav>
      <ChapterBadges badges={badges} class="chapter-title-badges" />
      <h1 class="gpl-display">{title}</h1>
      <p class="gpl-body-lg" style="color:var(--gray-600);margin:var(--space-2) 0 var(--space-6)">{summary}</p>
      <article><slot /></article>
    </main>
  </div>
  {practiceQuestions && <InstantQuestionPractice questions={practiceQuestions} certificationId={cert_id} chapterSlug={slug} />}
  <nav class="chapter-mobile-nav" aria-label="이전 및 다음 챕터">
    <div class="chapter-mobile-nav-inner">
      {previousChapter ? (
        <a
          class="chapter-mobile-link previous"
          href={chapterUrl(previousChapter)}
          rel="prev"
          aria-label={`이전 챕터: ${previousChapter.title}`}
        >
          <span class="chapter-mobile-arrow" aria-hidden="true">←</span>
          <span class="chapter-mobile-copy">
            <span class="chapter-mobile-label">이전 챕터</span>
            <span class="chapter-mobile-title">{previousChapter.title}</span>
          </span>
        </a>
      ) : (
        <span class="chapter-mobile-link previous is-disabled" aria-disabled="true">
          <span class="chapter-mobile-arrow" aria-hidden="true">←</span>
          <span class="chapter-mobile-copy">
            <span class="chapter-mobile-label">이전 챕터</span>
            <span class="chapter-mobile-title">첫 챕터입니다</span>
          </span>
        </span>
      )}
      {nextChapter ? (
        <a
          class="chapter-mobile-link next"
          href={chapterUrl(nextChapter)}
          rel="next"
          aria-label={`다음 챕터: ${nextChapter.title}`}
        >
          <span class="chapter-mobile-copy">
            <span class="chapter-mobile-label">다음 챕터</span>
            <span class="chapter-mobile-title">{nextChapter.title}</span>
          </span>
          <span class="chapter-mobile-arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="chapter-mobile-link next is-disabled" aria-disabled="true">
          <span class="chapter-mobile-copy">
            <span class="chapter-mobile-label">다음 챕터</span>
            <span class="chapter-mobile-title">마지막 챕터입니다</span>
          </span>
          <span class="chapter-mobile-arrow" aria-hidden="true">→</span>
        </span>
      )}
    </div>
  </nav>
  <dialog class="learning-image-dialog" aria-labelledby="learning-image-title">
    <div class="learning-image-header">
      <h2 id="learning-image-title">학습 그림 확대</h2>
      <button type="button" data-learning-image-close autofocus>닫기</button>
    </div>
    <p class="learning-image-hint" id="learning-image-hint" hidden></p>
    <div class="learning-image-scroll" tabindex="0" role="region" aria-label="확대한 학습 그림" aria-describedby="learning-image-hint">
      <img alt="" />
    </div>
  </dialog>
  <script>
    // Industrial chapter tables must keep their native table layout. On narrow screens,
    // wrap only tables that truly exceed the article width, leaving short tables full-width.
    const industrialArticle = document.querySelector('.industrial-safety-chapter article');
    if (industrialArticle instanceof HTMLElement) {
      const mobileTableViewport = window.matchMedia('(max-width: 767px)');
      const wrapOverflowingTables = () => {
        if (!mobileTableViewport.matches) return;
        const articleWidth = industrialArticle.clientWidth;
        industrialArticle.querySelectorAll(':scope > table').forEach((table) => {
          if (!(table instanceof HTMLTableElement)) return;
          if (table.getBoundingClientRect().width <= articleWidth + 1) return;
          const region = document.createElement('div');
          region.className = 'industrial-table-scroll';
          region.tabIndex = 0;
          region.setAttribute('role', 'region');
          region.setAttribute('aria-label', '가로로 스크롤할 수 있는 표');
          table.before(region);
          region.append(table);
        });
      };
      wrapOverflowingTables();
      window.addEventListener('resize', wrapOverflowingTables, { passive: true });
      document.fonts.ready.then(wrapOverflowingTables);
    }

    const desktopSubjectHover = window.matchMedia('(hover: hover) and (pointer: fine)');

    document.querySelectorAll('.subject-switcher').forEach((switcher) => {
      if (!(switcher instanceof HTMLDetailsElement)) return;

      switcher.addEventListener('mouseenter', () => {
        if (desktopSubjectHover.matches) switcher.open = true;
      });
      switcher.addEventListener('mouseleave', () => {
        if (desktopSubjectHover.matches) switcher.open = false;
      });

      document.addEventListener('click', (event) => {
        if (switcher.open && !switcher.contains(event.target as Node)) switcher.open = false;
      });
      switcher.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          switcher.open = false;
          switcher.querySelector('summary')?.focus();
        }
      });
    });

    // Progressive enhancement: preserve the original figure, caption and image asset.
    // Figures with their own controls or overlays keep their existing viewer.
    const imageDialog = document.querySelector('.learning-image-dialog');
    const enlargedImage = imageDialog?.querySelector('img');
    const enlargedTitle = imageDialog?.querySelector('h2');
    const imageScroll = imageDialog?.querySelector('.learning-image-scroll');
    const imageHint = imageDialog?.querySelector('.learning-image-hint');
    if (imageDialog instanceof HTMLDialogElement && enlargedImage instanceof HTMLImageElement && enlargedTitle && imageScroll instanceof HTMLElement && imageHint instanceof HTMLElement) {
      const updateImageHint = () => {
        if (!imageDialog.open) return;
        const horizontal = imageScroll.scrollWidth > imageScroll.clientWidth + 1;
        const vertical = imageScroll.scrollHeight > imageScroll.clientHeight + 1;
        imageHint.hidden = !horizontal && !vertical;
        imageHint.textContent = horizontal && vertical ? '그림을 좌우와 위아래로 이동해 전체를 확인하세요' : horizontal ? '그림을 좌우로 이동해 전체를 확인하세요' : vertical ? '그림을 위아래로 이동해 전체를 확인하세요' : '';
      };
      const resizeObserver = new ResizeObserver(updateImageHint);
      resizeObserver.observe(imageScroll);
      enlargedImage.addEventListener('load', updateImageHint);
      let opener: HTMLButtonElement | undefined;
      let saved: { x: number; y: number; styles: [string, string, string][] } | undefined;
      const properties = ['position', 'top', 'left', 'right', 'overflow', 'padding-right'];
      const restore = () => {
        if (!saved) return;
        const previous = saved;
        saved = undefined;
        for (const [key, value, priority] of previous.styles) {
          if (value) document.body.style.setProperty(key, value, priority);
          else document.body.style.removeProperty(key);
        }
        window.scrollTo(previous.x, previous.y);
        opener?.focus({ preventScroll: true });
        opener = undefined;
      };
      imageDialog.querySelector('[data-learning-image-close]')?.addEventListener('click', () => imageDialog.close());
      imageDialog.addEventListener('close', restore);
      imageDialog.addEventListener('cancel', event => {
        event.preventDefault();
        imageDialog.close();
      });
      imageDialog.addEventListener('click', event => {
        if (event.target !== imageDialog) return;
        const rect = imageDialog.getBoundingClientRect();
        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) imageDialog.close();
      });
      document.querySelectorAll('article .learning-visuals figure').forEach(figure => {
        if (figure.querySelector('button, a, svg') || figure.closest('.learning-visuals--boiler-circulation, .learning-visuals--boiler-types')) return;
        const original = figure.querySelector('img');
        if (!(original instanceof HTMLImageElement)) return;
        const label = figure.querySelector('figcaption strong')?.textContent?.trim() || '학습 그림';
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'learning-image-open';
        button.textContent = '그림 확대';
        button.setAttribute('aria-label', `${label} 확대 보기`);
        button.setAttribute('aria-haspopup', 'dialog');
        figure.appendChild(button);
        button.addEventListener('click', () => {
          if (imageDialog.open) return;
          enlargedImage.src = original.currentSrc || original.src;
          enlargedImage.alt = original.alt;
          const sourceWidth = Number(original.getAttribute('width')) || original.naturalWidth || original.width;
          enlargedImage.width = Math.ceil(Math.max(sourceWidth, original.getBoundingClientRect().width * 1.25));
          enlargedTitle.textContent = label;
          opener = button;
          saved = {
            x: scrollX, y: scrollY,
            styles: properties.map(key => [key, document.body.style.getPropertyValue(key), document.body.style.getPropertyPriority(key)]),
          };
          const scrollbar = innerWidth - document.documentElement.clientWidth;
          const padding = parseFloat(getComputedStyle(document.body).paddingRight) || 0;
          document.body.style.setProperty('position', 'fixed');
          document.body.style.setProperty('top', `-${saved.y}px`);
          document.body.style.setProperty('left', `-${saved.x}px`);
          document.body.style.setProperty('right', '0');
          document.body.style.setProperty('overflow', 'hidden');
          document.body.style.setProperty('padding-right', `${padding + scrollbar}px`);
          imageDialog.showModal();
          imageScroll.scrollTo(0, 0);
          requestAnimationFrame(updateImageHint);
        });
      });
    }
  </script>
</BaseLayout>
