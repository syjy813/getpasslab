---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import industrialSafetyQuestions from '../data/questions/industrial-safety.json';
import energyManagementQuestions from '../data/questions/energy-management.json';
import {
  getCertificationEntryPath,
  getFeaturedCertifications,
} from '../config/certifications';
import { withBase } from '../config/url';

const chapters = (await getCollection('chapters')).filter(c => c.data.status === '완료');
const certifications = getFeaturedCertifications();
const countByCertification = (certId: string) =>
  chapters.filter(chapter => chapter.data.cert_id === certId).length;
const questionCountByCertification: Record<string, number> = {
  'industrial-safety': industrialSafetyQuestions.length,
  'energy-management': energyManagementQuestions.length,
};
questionCountByCertification['computer-literacy'] = new Set(chapters.filter(c => c.data.cert_id === 'computer-literacy').flatMap(c => c.data.questions)).size;
const totalQuestionCount = Object.values(questionCountByCertification).reduce((sum, count) => sum + count, 0);
const formatCount = (count: number) => count.toLocaleString('ko-KR');
---
<BaseLayout
  title="GetPassLab — 자격증 핵심요약과 학습 그림"
  description={`국가기술자격 필기 기출 ${formatCount(totalQuestionCount)}문항의 출제 이력을 챕터별로 연결해 핵심 개념, 계산 공식, 법령 기준과 반복 출제 포인트를 정리한 학습 서비스입니다.`}
  bodyClass="catalog-page certification-home"
>
  <section class="hero">
    <div class="hero-inner">
      <span class="catalog-kicker">자격증의 모든 것</span>
      <h1 class="gpl-display">자격증 공부,<br/>개념부터 기출까지</h1>
    </div>
  </section>

  <section class="section container" id="certifications" aria-labelledby="certifications-title">
    <div class="section-heading">
      <h2 class="gpl-h1" id="certifications-title">어떤 자격증을 준비하나요?</h2>
    </div>
    <div class="grid certification-grid">
      {certifications.map((certification) => (
        <a class="card" href={withBase(getCertificationEntryPath(certification.slug))}>
          <span class="card-label">{certification.category}</span>
          <h3 class="card-title card-title-primary">{certification.name}</h3>
          <div class="card-description">{certification.summary}</div>
          <div class="card-meta">
            챕터 {countByCertification(certification.slug)}개
            {questionCountByCertification[certification.slug]
              ? ` · 기출 ${formatCount(questionCountByCertification[certification.slug])}문항`
              : ''}
          </div>
          <span class="catalog-card-action">학습 시작 <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>

  <section class="section container" style="padding-bottom:var(--space-16)">
    <div class="section-heading">
      <h2 class="gpl-h1">GetPassLab 학습 방식</h2>
      <p class="gpl-body">기출에서 반복되는 핵심 개념을 먼저 익히고, 연결된 실제 기출로 확인합니다.</p>
    </div>
    <ol class="learning-steps">
      <li>
        <span class="learning-step-number">1</span>
        <div>
          <strong>기출 분석</strong>
          <p>기출문항을 학습 주제에 연결해 반복되는 개념과 출제 회차를 확인합니다.</p>
        </div>
      </li>
      <li>
        <span class="learning-step-number">2</span>
        <div>
          <strong>개념 학습</strong>
          <p>정의·공식·단위·조건과 오답 판별 기준을 챕터별로 익힙니다.</p>
        </div>
      </li>
      <li>
        <span class="learning-step-number">3</span>
        <div>
          <strong>기출 확인</strong>
          <p>연결된 실제 기출을 열어 학습한 개념이 어떻게 출제됐는지 점검합니다.</p>
        </div>
      </li>
    </ol>
  </section>

</BaseLayout>

