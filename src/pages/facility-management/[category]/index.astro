---
import { getCollection, type CollectionEntry } from 'astro:content';
import FacilityLayout from '../../../layouts/FacilityLayout.astro';
import FacilityCard from '../../../components/FacilityCard.astro';
import FacilityBreadcrumb from '../../../components/FacilityBreadcrumb.astro';
import FacilityLearningLinks from '../../../components/FacilityLearningLinks.astro';
import { FACILITY_CATEGORIES, facilityCategoryPath, facilityNavigationCategorySlug, sortFacilityArticles } from '../../../config/facility';
import { withBase } from '../../../config/url';
import { SITE } from '../../../config/site';
export async function getStaticPaths() {
  const articles = await getCollection('facilityArticles', article => article.data.status === 'published' || (import.meta.env.FACILITY_DRAFT_PREVIEW === '1' && article.id !== 'reading-job-postings'));
  const primaryCategories = FACILITY_CATEGORIES.map(category => ({
    params: { category: category.slug },
    props: { category, articles: sortFacilityArticles(articles.filter(article => facilityNavigationCategorySlug(article) === category.slug)) },
  }));
  // Retain the indexed /jobs/ listing as an additional route, not a first-level category.
  return [...primaryCategories, {
    params: { category: 'jobs' },
    props: {
      category: { slug: 'jobs', name: '채용공고 분석', description: '기관과 사업소별 채용공고를 살펴보는 기존 분석 모음' },
      articles: sortFacilityArticles(articles.filter(article => article.data.category === 'jobs')),
    },
  }];
}
const { category, articles } = Astro.props;
const allAvailableArticles = await getCollection('facilityArticles', article => article.data.status === 'published' || (import.meta.env.FACILITY_DRAFT_PREVIEW === '1' && article.id !== 'reading-job-postings'));
const availableCategorySlugs = new Set(allAvailableArticles.map(facilityNavigationCategorySlug));
const legacyJobs = category.slug === 'jobs';
const breadcrumbs = [{ name: '시설의 모든 것', path: '/facility-management/' },
  ...(legacyJobs ? [{ name: '취업·커리어', path: facilityCategoryPath('career') }] : []),
  { name: category.name, path: facilityCategoryPath(category.slug) }];
// Series are read in episode order; the home feed keeps its existing date order.
const episodeNumber = (title: string): [number, number] => {
  const match = title.match(/\bep\.\s*(\d+)(?:-(\d+))?/i);
  return match ? [Number(match[1]), Number(match[2] ?? 0)] : [Number.MAX_SAFE_INTEGER, 0];
};
const sortSeriesEpisodes = (entries: CollectionEntry<'facilityArticles'>[]) =>
  [...entries].sort((a, b) => {
    const [majorA, minorA] = episodeNumber(a.data.title);
    const [majorB, minorB] = episodeNumber(b.data.title);
    return majorA - majorB || minorA - minorB || a.id.localeCompare(b.id);
  });
const groups = category.slug === 'career' ? [
  { title: '취업 가이드', articles: articles.filter(article => article.data.category !== 'jobs' || article.id === 'public-sector-comparison') },
  { title: '기업·채용 분석', articles: articles.filter(article => article.data.category === 'jobs' && article.id !== 'public-sector-comparison') },
] : category.slug === 'stories' ? [
  { title: '호병백마 시리즈', articles: sortSeriesEpisodes(articles.filter(article => article.id.startsWith('hobyeongbaekma'))) },
  { title: '사수골대 시리즈', articles: sortSeriesEpisodes(articles.filter(article => article.id.startsWith('sasugoldae'))) },
  { title: '다른 시설 이야기', articles: articles.filter(article => !article.id.startsWith('hobyeongbaekma') && !article.id.startsWith('sasugoldae')) },
] : [{ title: '', articles }];
const structuredData = [{ '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.name, item: new URL(withBase(item.path), SITE.url).href })) }];
---
<FacilityLayout title={`${category.name} — 시설의 모든 것 | GetPassLab`} description={`${category.description}. 시설의 모든 것에서 공개된 콘텐츠와 근거 자료를 확인하고, 관련 카테고리와 자격증 학습 페이지로 이어서 탐색하세요.`} robots={articles.length ? 'index, follow' : 'noindex, follow'} structuredData={structuredData}>
  <div class="facility-category-page">
    <FacilityBreadcrumb items={legacyJobs ? [{ name: '취업·커리어', path: facilityCategoryPath('career') }, { name: category.name }] : [{ name: category.name }]} />
    <header class="facility-intro facility-category-header">
      <h1 class="gpl-h1">{category.name}</h1>
      <p class="gpl-body">{category.description}</p>
      <span class="gpl-caption">공개 콘텐츠 {articles.length}개</span>
    </header>
    <section class="facility-section facility-category-list" aria-label={`${category.name} 콘텐츠`}>
    {articles.length ? groups.filter(group => group.articles.length > 0).map((group, index) => (
      <section class:list={['facility-category-subgroup', { 'facility-section': index > 0 }]} aria-label={group.title || `${category.name} 글 목록`}>
        {group.title && <div class="facility-section-head">
          <h2 class="gpl-h2">{group.title}</h2>
          {category.slug === 'career' && group.title === '기업·채용 분석' && (
            <a href={withBase(facilityCategoryPath('jobs'))}>채용공고 분석 모음 보기 →</a>
          )}
        </div>}
        <div class="grid grid-3">{group.articles.map(article => <FacilityCard article={article} />)}</div>
      </section>
    )) : <div class="facility-empty"><h2 class="gpl-h3">콘텐츠를 준비하고 있습니다</h2><p>공개된 입문 안내나 관련 자격증 학습을 먼저 살펴보세요.</p><a href={withBase('/facility-management/intro/')}>시설관리 입문 살펴보기 →</a></div>}
  </section>
  <section class="facility-section" aria-labelledby="related-categories-title"><h2 id="related-categories-title" class="gpl-h2">다른 카테고리 살펴보기</h2><nav aria-label="시설관리 카테고리"><ul class="facility-category-nav">{FACILITY_CATEGORIES.filter(item => availableCategorySlugs.has(item.slug)).map(item => <li><a href={withBase(facilityCategoryPath(item.slug))} aria-current={item.slug === (legacyJobs ? 'career' : category.slug) ? 'page' : undefined}>{item.name}</a></li>)}</ul></nav></section>
  <FacilityLearningLinks />
  </div>
</FacilityLayout>
