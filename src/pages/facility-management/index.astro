---
import { getCollection } from 'astro:content';
import FacilityLayout from '../../layouts/FacilityLayout.astro';
import FacilityCard from '../../components/FacilityCard.astro';
import FacilityIcon from '../../components/FacilityIcon.astro';
import FacilityLearningLinks from '../../components/FacilityLearningLinks.astro';
import { FACILITY_CATEGORIES, facilityCategoryPath, sortFacilityArticles } from '../../config/facility';
import { withBase } from '../../config/url';

const articles = sortFacilityArticles(await getCollection('facilityArticles', article =>
  article.data.status === 'published' || (import.meta.env.FACILITY_DRAFT_PREVIEW === '1' && article.id !== 'reading-job-postings')
));
const lead = articles.find(article => article.id === 'what-is-facility-management')
  ?? articles.find(article => article.data.featured)
  ?? articles[0];
const categories = FACILITY_CATEGORIES.map(category => ({
  ...category,
  articles: articles.filter(article => article.data.category === category.slug),
}));
const availableCategories = categories.filter(category => category.articles.length > 0);
const upcomingCategories = categories.filter(category => category.articles.length === 0);
const articleGroups = availableCategories.map(category => ({
  ...category,
  articles: category.articles.filter(article => article.id !== lead?.id),
})).filter(category => category.articles.length > 0);
---
<FacilityLayout title="시설의 모든 것 — 시설관리 입문·취업·실무 | GetPassLab" description="시설관리 입문부터 취업·이직, 자격증·법정선임, 시설관리 실무까지. 공식 자료와 확인 기준일을 함께 제공하는 GetPassLab의 시설관리 정보 서비스입니다.">
  <section class="facility-intro">
    <span class="facility-eyebrow">GetPassLab · 시설의 모든 것</span>
    <h1 class="gpl-display">시설관리의 모든 것</h1>
    <p>취업부터 법정선임, 실무까지.<br />일을 시작하고 경력을 쌓을 때 필요한 정보를 쉽게 알아보세요.</p>
    <div class="facility-actions">
      <a class="btn btn-primary" href="#facility-content">추천 글 읽기</a>
      <a class="btn btn-secondary" href={withBase('/certifications/')}>자격증 학습하기 <span aria-hidden="true">→</span></a>
    </div>
  </section>

  {lead && <section class="facility-section facility-featured" id="facility-content" aria-labelledby="facility-featured-title">
    <div class="facility-section-head">
      <h2 id="facility-featured-title" class="gpl-h2">처음이라면 이 글부터</h2>
      <span class="gpl-caption">시설관리 입문</span>
    </div>
    <FacilityCard article={lead} lead />
  </section>}

  <section class="facility-section facility-categories" aria-labelledby="facility-category-title">
    <div class="facility-section-head"><h2 id="facility-category-title" class="gpl-h2">관심 있는 주제부터</h2></div>
    <nav class="facility-category-grid" aria-label="시설관리 주제">
      {availableCategories.map(category => (
        <a class="facility-category-link" href={withBase(facilityCategoryPath(category.slug))}>
          <span class="facility-category-icon"><FacilityIcon name={category.icon} /></span>
          <span class="facility-category-copy"><strong>{category.name}</strong><span>{category.description}</span><small>콘텐츠 {category.articles.length}개</small></span>
          <span class="facility-category-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>
    {upcomingCategories.length > 0 && <p class="facility-upcoming">준비 중인 주제: {upcomingCategories.map(category => category.name).join(', ')}</p>}
  </section>

  {articleGroups.map(category => (
    <section class="facility-section" aria-labelledby={'facility-group-' + category.slug}>
      <div class="facility-section-head">
        <h2 id={'facility-group-' + category.slug} class="gpl-h2">{category.slug === 'career' ? '시설관리 취업 가이드' : category.name}</h2>
        <a href={withBase(facilityCategoryPath(category.slug))}>전체 보기 <span aria-hidden="true">→</span></a>
      </div>
      <div class="facility-story-grid">{category.articles.slice(0, 6).map(article => <FacilityCard article={article} />)}</div>
    </section>
  ))}

  {articles.length === 0 && <section class="facility-section"><div class="facility-empty"><h2 class="gpl-h3">첫 콘텐츠를 준비하고 있습니다</h2><p>그동안 관련 자격증의 이론 학습을 시작해 보세요.</p><a href={withBase('/certifications/')}>자격증 학습하러 가기 →</a></div></section>}
  <FacilityLearningLinks />
</FacilityLayout>
