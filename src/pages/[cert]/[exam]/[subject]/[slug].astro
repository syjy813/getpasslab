---
import { getCollection, render } from 'astro:content';
import ChapterLayout from '../../../../layouts/ChapterLayout.astro';
import QuestionHistory from '../../../../components/QuestionHistory.astro';
import RelatedChapters from '../../../../components/RelatedChapters.astro';
import { getSubject } from '../../../../config/certifications';
import { getQuestionImage } from '../../../../config/questionImages';
import {
  createChapterBadgeContext,
  getChapterBadgeSummary,
} from '../../../../utils/chapterBadges';

export async function getStaticPaths() {
  const chapters = (await getCollection('chapters')).filter(chapter => chapter.data.status === '완료');
  return chapters.map((chapter) => {
    const subject = getSubject(chapter.data.cert_id, chapter.data.exam, chapter.data.subject_id);
    if (!subject) {
      throw new Error(
        `Unknown chapter scope: ${chapter.data.cert_id}/${chapter.data.exam}/${chapter.data.subject_id} (${chapter.data.slug})`,
      );
    }

    return {
      params: {
        cert: chapter.data.cert_id,
        exam: chapter.data.exam,
        subject: subject.slug,
        slug: chapter.data.slug,
      },
      props: { chapter },
    };
  });
}

const { chapter } = Astro.props;
const { Content } = await render(chapter);

const allQuestions = (await getCollection('questions')).filter(
  question => question.data.cert_id === chapter.data.cert_id
    && question.data.exam === chapter.data.exam,
);
const badgeContext = createChapterBadgeContext(allQuestions.map(question => question.data));
const badgeSummary = getChapterBadgeSummary(
  chapter.data.tags,
  chapter.data.questions,
  badgeContext,
);
const questionsById = new Map(allQuestions.map(question => [question.data.id, question.data]));
const seenQuestionIds = new Set<string>();
const linked = [];

for (const questionId of chapter.data.questions ?? []) {
  if (seenQuestionIds.has(questionId)) continue;
  seenQuestionIds.add(questionId);

  const question = questionsById.get(questionId);
  if (!question) {
    console.warn(
      `[public-question-filter] chapter=${chapter.data.slug} question_id=${questionId} excluded: missing from certification question data`,
    );
    continue;
  }

  const exclusionReasons: string[] = [];
  if (question.review === 'jpg 확필') exclusionReasons.push('review=jpg 확필');
  if (!Array.isArray(question.choices) || question.choices.length !== 4) {
    exclusionReasons.push(
      `choices length is ${Array.isArray(question.choices) ? question.choices.length : 'not-an-array'}`,
    );
  } else if (question.choices.some(choice => typeof choice !== 'string' || choice.trim() === '')) {
    exclusionReasons.push('blank choice');
  }

  if (exclusionReasons.length > 0) {
    console.warn(
      `[public-question-filter] chapter=${chapter.data.slug} question_id=${questionId} excluded: ${exclusionReasons.join('; ')}`,
    );
    continue;
  }

  linked.push({
    ...question,
    image: getQuestionImage(question.cert_id, question.id),
  });
}

type DeferredQuestionDataset = 'energy-management' | 'industrial-safety';
const deferredQuestionDataset = (
  chapter.data.cert_id === 'energy-management' || chapter.data.cert_id === 'industrial-safety'
)
  ? chapter.data.cert_id as DeferredQuestionDataset
  : undefined;

const allChapters = (await getCollection('chapters')).filter(
  candidate => candidate.data.status === '완료'
    && candidate.data.cert_id === chapter.data.cert_id
    && candidate.data.exam === chapter.data.exam,
);
const subjectStartChapters = [...new Set(allChapters.map(candidate => candidate.data.subject_id))]
  .sort((a, b) => a - b)
  .map((candidateSubjectId) => {
    const candidateChapters = allChapters.filter(
      candidate => candidate.data.subject_id === candidateSubjectId,
    );
    const hasSubjectWideOrder = new Set(
      candidateChapters.map(candidate => candidate.data.order),
    ).size === candidateChapters.length;
    const orderedChapters = hasSubjectWideOrder
      ? [...candidateChapters].sort(
          (a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug),
        )
      : candidateChapters;

    return {
      subjectId: candidateSubjectId,
      chapterSlug: orderedChapters[0]?.data.slug,
    };
  })
  .filter((item): item is { subjectId: number; chapterSlug: string } => Boolean(item.chapterSlug));
const manual = chapter.data.related
  .map(slug => allChapters.find(candidate => candidate.data.slug === slug)?.data)
  .filter(Boolean);
const sameGroup = allChapters
  .filter(candidate => candidate.data.group === chapter.data.group && candidate.data.slug !== chapter.data.slug)
  .map(candidate => candidate.data);
const subjectChapters = allChapters
  .filter(candidate => candidate.data.subject_id === chapter.data.subject_id);
const hasSubjectWideOrder = new Set(
  subjectChapters.map(candidate => candidate.data.order),
).size === subjectChapters.length;
const orderedSideChapters = hasSubjectWideOrder
  ? [...subjectChapters].sort(
      (a, b) => a.data.order - b.data.order || a.data.slug.localeCompare(b.data.slug),
    )
  : subjectChapters;
const sideChapters = orderedSideChapters
  .map(candidate => ({
    slug: candidate.data.slug,
    title: candidate.data.title,
    group: candidate.data.group,
  }));
---
<ChapterLayout
  {...chapter.data}
  badges={badgeSummary.badges}
  sideChapters={sideChapters}
  subjectStartChapters={subjectStartChapters}
>
  <Content />
  <QuestionHistory
    questions={linked as any}
    examComment={chapter.data.examComment}
    deferredQuestionDataset={deferredQuestionDataset}
  />
  <RelatedChapters
    manual={manual as any}
    sameGroup={sameGroup as any}
    certId={chapter.data.cert_id}
    examSlug={chapter.data.exam}
  />
</ChapterLayout>